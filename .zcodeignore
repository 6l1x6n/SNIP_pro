# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Env / secrets
.env
backend/.env
.env.local
*.local

# Storage
backend/storage/
backend/storage

# Logs
*.log
npm-debug.log*

# Large binary documents (not source code)
*.pdf
!frontend/public/*.pdf

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/

# Docker volumes (local data)
pgdata/
caddy_data/
caddy_config/

# Wrangler
.wrangler/
frontend/.wrangler/
worker/.dev.vars

# Локальный кэш эмбеддингов для пересборок индекса (--reuse-vectors)
.index_cache/

# offline eval
scripts/eval/.eval_token
scripts/eval/embed_cache.json
scripts/eval/rewrite_cache.json

# Корпус нормативки (тяжёлый, качается по norms_refresh.sh) — метаданные в git
norms/*
!norms/meta.json

# Рабочий мусор / черновики
assets/
.zcode/
worker/tmp-tail/
*.tsbuildinfo
logo_snake*.png

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
bower_components/
jspm_packages/
site-packages/
coverage/
htmlcov/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
