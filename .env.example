POSTGRES_USER=snip
POSTGRES_PASSWORD=change_me_strong_32_chars
POSTGRES_DB=snip_pro
SECRET_KEY=please-generate-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ADMIN_EMAIL=postalarchive@gmail.com

DATABASE_URL=postgresql+asyncpg://snip:change_me_strong_32_chars@db:5432/snip_pro
SYNC_DATABASE_URL=postgresql://snip:change_me_strong_32_chars@db:5432/snip_pro
CORS_ORIGINS=https://snippy-llm.pages.dev,https://snippy-llm.workers.dev,http://localhost:5173,https://*.pages.dev,https://*.workers.dev,https://*.onrender.com
VITE_API_BASE=https://snippy-llm.pages.dev
# Cloudflare Pages free — фронт отдельно, бэк отдельно (без домена):
# VITE_API_BASE=https://<render-backend>.onrender.com  # задайте в Pages Dashboard → Environment variables
# Без БД режим (Cloudflare Pages только фронт): DISABLE_DB=1
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Провайдер эмбеддингов:
#   gemini = удалённо, Google text-embedding-004 768d, free tier без карты — для Koyeb/Render free 512MB RAM (рекомендую)
#   fastembed = локальный ONNX MiniLM 384d (нужен ~1GB RAM под модель)
#   "" (пусто) = авто (sentence-transformers если установлен)
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=... # https://aistudio.google.com/apikey (бесплатно, без карты)
EMBEDDING_DIM=768 # при gemini; 384 при fastembed/sentence-transformers
# Модель эмбеддингов Gemini (по умолчанию gemini-embedding-001, text-embedding-004 decommissioned 2026)
OLLAMA_HOST=https://api.groq.com/openai/v1
OLLAMA_MODEL=llama-3.1-8b-instant
GROQ_API_KEY=gsk_... # https://console.groq.com/keys
GROQ_MODEL=llama-3.1-8b-instant
ENABLE_COLLECTOR=0
# Квота — безлимит для Pages free:
QUOTA_ENABLED=0
QUOTA_ANON_LIMIT=999999
QUOTA_REGISTERED_LIMIT=999999
DISABLE_DB=0
